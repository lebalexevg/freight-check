/* ===================================================================
   Стили утилиты «Рейс-Проверка» (freight-check)
   Концепция: Инженерный минимализм (Linear, Sublime Merge, 1Password)
   Палитра: Светлая Slate/Zinc (#F8FAFC / #FFFFFF / #E2E8F0)
   =================================================================== */

/* Базовые параметры окна и шрифтов */
QMainWindow, QDialog {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 12px;
}

QWidget {
    color: #0F172A;
}

/* 1. Верхний компактный тулбар */
QFrame#topToolbar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QToolButton#demoMenuBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    padding: 2px 10px;
    font-weight: 600;
    font-size: 12px;
    qproperty-iconSize: 12px 12px;
}

QToolButton#demoMenuBtn:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QToolButton#demoMenuBtn:pressed {
    background-color: #E2E8F0;
}

QPushButton#toolbarResetBtn {
    background-color: #F8FAFC;
    color: #64748B;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 2px 10px;
    font-weight: 500;
    font-size: 12px;
    qproperty-iconSize: 12px 12px;
}

QPushButton#toolbarResetBtn:hover {
    color: #0F172A;
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

/* Выпадающие меню QMenu */
QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    font-size: 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

/* 2. Адаптивная зона документов */
QFrame#dropZone {
    background-color: #FFFFFF;
    border: 1px dashed #CBD5E1;
    border-radius: 6px;
}

QFrame#dropZone:hover {
    border-color: #3B82F6;
    background-color: #F8FAFC;
}

QFrame#dropZone[dragOver="true"] {
    border-color: #2563EB;
    border-style: solid;
    background-color: #EFF6FF;
}

QFrame#dropZone[hasFile="true"] {
    border: 1px solid #CBD5E1;
    background-color: #FFFFFF;
}

/* Кнопки внутри компактного слота документов */
QPushButton#compactActionBtn {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
    qproperty-iconSize: 12px 12px;
}

QPushButton#compactActionBtn:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
    color: #0F172A;
}

QPushButton#compactClearBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    qproperty-iconSize: 14px 14px;
}

QPushButton#compactClearBtn:hover {
    background-color: #FEE2E2;
}

/* 3. Инфо-полоса сводки */
QFrame#summaryBar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

/* Чекбокс фильтрации расхождений с четкой иконкой */
QCheckBox {
    font-size: 12px;
    font-weight: 500;
    color: #334155;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #CBD5E1;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #94A3B8;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: 1px solid #1D4ED8;
    image: url("assets/styles/checkmark.svg");
}

/* Базовые кнопки */
QPushButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

/* 4. Таблица результатов QTableView */
QTableView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #E0E7FF;
    selection-color: #0F172A;
    outline: none;
}

QTableView QWidget#qt_scrollarea_viewport {
    background-color: #FFFFFF;
}

QTableView::item {
    border-bottom: 1px solid #F1F5F9;
    padding: 0px 8px;
}

QTableView::item:selected {
    background-color: #E0E7FF;
    color: #0F172A;
}

/* Заголовки таблицы QHeaderView */
QHeaderView {
    background-color: #F8FAFC;
    border: none;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 4px 10px;
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #F1F5F9;
}

QHeaderView::up-arrow {
    width: 9px;
    height: 9px;
    padding-right: 6px;
}

QHeaderView::down-arrow {
    width: 9px;
    height: 9px;
    padding-right: 6px;
}

/* 5. Полоса прокрутки (минималистичный QScrollBar) */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 6. Системный статус-бар с симметричными отступами */
QStatusBar {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    color: #64748B;
    font-size: 11px;
    min-height: 28px;
    padding: 0px;
}

QStatusBar::item {
    border: none;
}

/* Тонкий прогресс-бар */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 2px;
    height: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 2px;
}
