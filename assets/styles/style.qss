/* ===================================================================
   Стили утилиты «Рейс-Проверка» (freight-check)
   Концепция: Инженерный минимализм (Linear, Sublime Merge, 1Password)
   Палитра: High-Contrast Slate (#F1F5F9 / #FFFFFF / #CBD5E1 / #94A3B8)
   =================================================================== */

/* Базовые параметры окна и шрифтов */
QMainWindow, QDialog {
    background-color: #F1F5F9;
    color: #0F172A;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 14px;
}

QDialog#aboutDialog {
    background-color: #FFFFFF;
}

QWidget {
    color: #0F172A;
}

QToolButton#demoMenuBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 13px;
    qproperty-iconSize: 12px 12px;
}

QToolButton#demoMenuBtn:hover {
    background-color: #F8FAFC;
    border-color: #64748B;
    color: #0F172A;
}

QToolButton#demoMenuBtn:pressed {
    background-color: #E2E8F0;
}

QPushButton#toolbarResetBtn {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 13px;
    qproperty-iconSize: 12px 12px;
}

QPushButton#toolbarResetBtn:hover {
    color: #0F172A;
    background-color: #F8FAFC;
    border-color: #64748B;
}

QPushButton#toolbarResetBtn:pressed {
    background-color: #E2E8F0;
}

QPushButton#toolbarHelpBtn {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 0px;
    qproperty-iconSize: 13px 13px;
}

QPushButton#toolbarHelpBtn:hover {
    color: #0F172A;
    background-color: #F8FAFC;
    border-color: #64748B;
}

QPushButton#toolbarHelpBtn:pressed {
    background-color: #E2E8F0;
}

/* Выпадающие меню QMenu */
QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    font-size: 13px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

/* 2. Адаптивная зона документов */
QFrame#dropZone {
    background-color: #FFFFFF;
    border: none;
    border-radius: 2px;
}

QFrame#dropZone[dragOver="true"] {
    background-color: #EFF6FF;
}

QFrame#dropZone[compact="true"] {
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    background-color: #FFFFFF;
}

QFrame#dropZone[compact="true"]:hover {
    border: 2px solid #94A3B8;
    background-color: #FFFFFF;
}

QFrame#dropZone[compact="false"][hasFile="true"] {
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    background-color: #FFFFFF;
}

QFrame#dropZone[compact="false"][hasFile="true"]:hover {
    border: 2px solid #94A3B8;
    background-color: #FFFFFF;
}

/* Кнопка выбора файла в полноэкранной карточке */
QPushButton#dropZoneBrowseBtn {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 7px 20px;
    font-size: 14px;
    font-weight: 600;
    qproperty-iconSize: 16px 16px;
}

QPushButton#dropZoneBrowseBtn:hover {
    background-color: #EFF6FF;
    border-color: #3B82F6;
    color: #1D4ED8;
}

QPushButton#dropZoneBrowseBtn:pressed {
    background-color: #DBEAFE;
}

/* Кнопки управления файлом в полноэкранном слоте (друг под другом) */
QPushButton#expandedActionBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    qproperty-iconSize: 14px 14px;
}

QPushButton#expandedActionBtn:hover {
    background-color: #F8FAFC;
    border-color: #64748B;
    color: #0F172A;
}

QPushButton#expandedActionBtn:pressed {
    background-color: #F1F5F9;
}

/* Кнопки внутри компактного слота документов (строгие, плоские) */
QPushButton#compactActionBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 500;
    qproperty-iconSize: 13px 13px;
}

QPushButton#compactActionBtn:hover {
    background-color: #F8FAFC;
    border-color: #64748B;
    color: #0F172A;
}

QPushButton#compactClearBtn {
    background-color: #FFFFFF;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 0px;
    margin: 0px;
    qproperty-iconSize: 12px 12px;
}

QPushButton#compactClearBtn:hover {
    background-color: #FEE2E2;
    border-color: #EF4444;
}

/* 3. Инфо-полоса сводки */
QFrame#summaryBar {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
}

/* Чекбокс фильтрации расхождений с четкой иконкой */
QCheckBox {
    font-size: 13px;
    font-weight: 500;
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    border: 1px solid #94A3B8;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #64748B;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: 1px solid #1D4ED8;
    image: url("assets/styles/checkmark.svg");
}

/* Базовые кнопки */
QPushButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    padding: 5px 14px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #64748B;
    color: #0F172A;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

/* 4. Таблица результатов QTableView */
QTableView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    gridline-color: transparent;
    selection-background-color: #E0E7FF;
    selection-color: #0F172A;
    outline: none;
}

QTableView QWidget#qt_scrollarea_viewport {
    background-color: #FFFFFF;
}

QTableView::item {
    border-bottom: 1px solid #E2E8F0;
    padding: 4px 8px;
}

QTableView::item:selected {
    background-color: #E0E7FF;
    color: #0F172A;
}

/* Заголовки таблицы QHeaderView */
QHeaderView {
    background-color: #F1F5F9;
    border: none;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    text-align: left;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 13px;
    border: none;
    border-bottom: 1px solid #CBD5E1;
    border-right: 1px solid #E2E8F0;
}

QHeaderView::up-arrow, QHeaderView::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}

/* 5. Полоса прокрутки (минималистичный QScrollBar) */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #94A3B8;
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #94A3B8;
    border-radius: 2px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 6. Системный статус-бар с симметричными отступами */
QStatusBar {
    background-color: #F1F5F9;
    border-top: 1px solid #CBD5E1;
    color: #475569;
    font-size: 12px;
    min-height: 28px;
    padding: 0px 16px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0px;
}

QLabel#metricsCheckedLabel,
QLabel#metricsTimeLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
    padding: 0px 4px;
}

/* Тонкий 1px разделитель статус-бара */
QFrame#statusSep {
    background-color: #CBD5E1;
    border: none;
    min-width: 1px;
    max-width: 1px;
    width: 1px;
    min-height: 14px;
    max-height: 14px;
    height: 14px;
}

/* Заметный удлиненный прогресс-бар по центру */
QProgressBar {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 2px;
}

/* Кнопка версии в статус-баре */
QPushButton#statusVersionBtn {
    background-color: transparent;
    color: #64748B;
    border: none;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 2px;
}

QPushButton#statusVersionBtn:hover {
    color: #0F172A;
    background-color: #E2E8F0;
}

QPushButton#statusVersionBtn:pressed {
    background-color: #CBD5E1;
}

/* Кнопка закрытия модального окна «О программе» (стандартный системный стиль) */
QPushButton#aboutCloseBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#aboutCloseBtn:hover {
    color: #0F172A;
    background-color: #F8FAFC;
    border-color: #64748B;
}

QPushButton#aboutCloseBtn:pressed {
    background-color: #E2E8F0;
}
